{
  "name": "rust-all-action",
  "version": "1.0.0",
  "description": "A GitHub Action to run multiple Rust workflows (build, test, clippy, fmt) with caching support.",
  "license": "UNLICENSE",
  "type": "module",
  "dependencies": {
    "@actions/cache": "^6.1.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/http-client": "^4.0.1",
    "@actions/io": "^3.0.2",
    "string-argv": "^0.3.2",
    "toml": "^4.1.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "~26.0.1",
    "@vercel/ncc": "^0.44.0",
    "prettier": "~3.9.0",
    "rimraf": "~6.1.3",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "pnpm run clean && ncc build src/main.ts",
    "build:watch": "ncc build src/main.ts --watch",
    "--------------": "",
    "test": "node --import tsx --test",
    "-------------- ": "",
    "prepublishOnly": "pnpm run test && pnpm run build",
    "clean": "rimraf dist",
    "fmt": "prettier --config .prettierrc --write ."
  },
  "packageManager": "pnpm@10.15.0",
  "release-it": {
    "github": {
      "release": true
    }
  }
}
